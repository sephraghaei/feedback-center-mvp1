# App
BETTER_AUTH_URL=https://feedback-center-mvp1.vercel.app/

# Database (Postgres). DATABASE_URL wins; Vercel Postgres and Supabase
# integrations can also provide POSTGRES_URL, POSTGRES_PRISMA_URL or
# POSTGRES_URL_NON_POOLING and the app picks them up.
# For Supabase use the session pooler host, aws-0-<region>.pooler.supabase.com
# with the postgres.<project-ref> user. Direct db.<project-ref>.supabase.co
# connections are IPv6 only and fail on Vercel with ENOTFOUND.
DATABASE_URL=postgresql://USER@localhost:5432/feedback_center

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Storage for post covers and attachments. Server-only secret from the Supabase
# dashboard (Project Settings -> API keys). Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Email OTP (Resend). Email login skips sending and shows the code in the
# interface when these are empty.
RESEND_API_KEY=
RESEND_FROM=

# Session signing (falls back to KAVENEGAR_API_KEY when empty)
BETTER_AUTH_SECRET=

# Admin panel (/admin). Password-only login; no email, phone or username.
# Leave empty to disable the admin panel.
ADMIN_PASSWORD=

# Clerk (email and Google login). `npx clerk init` writes development keys to
# .env.local; for production copy the keys from the Clerk dashboard into Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OTP
OTP_LENGTH=4
OTP_EXPIRES_IN_SECONDS=300
OTP_ALLOWED_ATTEMPS=3

# Kavenegar SMS (login OTP)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=feedbackcenter-template
KAVENEGAR_SENDER_TYPE=sms

# Logging (DEBUG, INFO, WARN, ERROR). Leave LOG_FORMAT empty for pretty in
# development and JSON in production.
LOG_LEVEL=INFO
LOG_FORMAT=
NEXT_PUBLIC_LOG_LEVEL=INFO
